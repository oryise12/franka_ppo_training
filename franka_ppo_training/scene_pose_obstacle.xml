<mujoco model="panda pose obstacle scene">
  <include file="panda.xml"/>

  <statistic center="0.3 0 0.4" extent="1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <body name="target_bottle" mocap="true">
      <geom type="sphere" size="0.04" rgba="1 0 0 0.8" contype="0" conaffinity="0"/>
    </body>

    <body name="ai_action" mocap="true">
      <geom type="sphere" size="0.02" rgba="0 0 1 0.8" contype="0" conaffinity="0"/>
    </body>

    <body name="ai_action_arrow" mocap="true">
      <geom name="ai_action_arrow_shaft" type="capsule" fromto="0 0 0 0.12 0 0" size="0.009"
        rgba="0 0.35 1 0.9" contype="0" conaffinity="0"/>
      <geom name="ai_action_arrow_head_1" type="capsule" fromto="0.085 0.026 0 0.12 0 0" size="0.008"
        rgba="0 0.35 1 0.9" contype="0" conaffinity="0"/>
      <geom name="ai_action_arrow_head_2" type="capsule" fromto="0.085 -0.026 0 0.12 0 0" size="0.008"
        rgba="0 0.35 1 0.9" contype="0" conaffinity="0"/>
    </body>

    <body name="ee_arrow" mocap="true">
      <geom name="ee_arrow_shaft" type="capsule" fromto="0 0 0 0.10 0 0" size="0.008"
        rgba="0 1 0.2 0.9" contype="0" conaffinity="0"/>
      <geom name="ee_arrow_head_1" type="capsule" fromto="0.072 0.022 0 0.10 0 0" size="0.007"
        rgba="0 1 0.2 0.9" contype="0" conaffinity="0"/>
      <geom name="ee_arrow_head_2" type="capsule" fromto="0.072 -0.022 0 0.10 0 0" size="0.007"
        rgba="0 1 0.2 0.9" contype="0" conaffinity="0"/>
    </body>

    <body name="target_arrow" mocap="true">
      <geom name="target_arrow_shaft" type="capsule" fromto="0 0 0 0.16 0 0" size="0.012"
        rgba="1 0 1 0.9" contype="0" conaffinity="0"/>
      <geom name="target_arrow_head_1" type="capsule" fromto="0.11 0.035 0 0.16 0 0" size="0.010"
        rgba="1 0 1 0.9" contype="0" conaffinity="0"/>
      <geom name="target_arrow_head_2" type="capsule" fromto="0.11 -0.035 0 0.16 0 0" size="0.010"
        rgba="1 0 1 0.9" contype="0" conaffinity="0"/>
    </body>

    <body name="obstacle" mocap="true" pos="0.45 0 0.35">
      <geom name="obstacle_geom" type="box" size="0.018 0.035 0.035" rgba="1 0.45 0 0.65"
        contype="1" conaffinity="1" condim="3"/>
    </body>

    <body name="contact_marker" mocap="true" pos="0 0 -1">
      <geom name="contact_marker_geom" type="sphere" size="0.018" rgba="1 0 0 1"
        contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
